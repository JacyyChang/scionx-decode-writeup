options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: '05a = step 1 of the 05_GNURadio_Czechia pipeline: cs16 IQ -> 48k wav
      + periodic spectrogram PNGs. Regenerating this flowgraph (GRC "Generate"/ "Run",
      or `grcc`) always writes IQtoOgg_plot.py -- the GRC id below must stay a valid
      Python identifier (can''t start with a digit), so it can''t itself carry the
      05a prefix. After regenerating, rename the output IQtoOgg_plot.py -> 05a_IQtoOgg_plot.py
      by hand (or re-run whatever script last did it) so the tracked, run-this-one
      file keeps the prefix.'
    copyright: ''
    description: 'Step 1 (05a): decode a cs16 IQ capture to 48k wav, saving a periodic
      spectrogram PNG every 30s of newly-arrived IQ for candidate-frame scanning.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: IQtoOgg_plot
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Not titled yet
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: cs16_path
  id: variable
  parameters:
    comment: The recording being processed this run -- edit this one line to switch
      inputs. rec_stem (below) and blocks_file_source_0.file both derive from it,
      so nothing else needs touching per-run.
    value: r"D:\Research\3_SCIONX GNURadio\1_Share\appendix_gnuradio\Data\20260723_091639_100000_98266_x.cs16"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 180]
    rotation: 0
    state: enabled
- name: n_capture
  id: variable
  parameters:
    comment: How many samples each Plot Capture block captures (30 s @ 100 kHz).
    value: 60*100000
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 24.0]
    rotation: 0
    state: enabled
- name: rec_stem
  id: variable
  parameters:
    comment: 'date_time prefix pulled from cs16_path''s filename (drops the samp-rate/NORAD-ID/_x
      fields) -- e.g. 20260720_220206_100000_98266_x -> 20260720_220206 -- so Plot
      Capture / Wav Sink output filenames stay tied to the source recording instead
      of a fixed ''iq''/''demod'' prefix. No os import: GRC''s own design-time variable
      evaluator does not see Import-block names (only the generated file does), so
      this has to be plain string ops, not os.path.'
    value: '"_".join(cs16_path.replace("\\", "/").rsplit("/", 1)[-1].split("_")[:2])'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 304.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '100000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [224, 16.0]
    rotation: 0
    state: enabled
- name: variable_low_pass_filter_taps_0_2
  id: variable_low_pass_filter_taps
  parameters:
    beta: '6.76'
    comment: ''
    cutoff_freq: '15000'
    gain: '1.0'
    samp_rate: samp_rate
    value: ''
    width: '1000'
    win: window.WIN_HAMMING
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1016, 488.0]
    rotation: 0
    state: enabled
- name: analog_quadrature_demod_cf_0_1_0
  id: analog_quadrature_demod_cf
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    gain: 15.91*2
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1440, 420.0]
    rotation: 0
    state: enabled
- name: blocks_file_source_0
  id: blocks_file_source
  parameters:
    affinity: ''
    alias: ''
    begin_tag: pmt.PMT_NIL
    comment: ''
    file: cs16_path
    length: '0'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    repeat: 'False'
    type: short
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [352, 204.0]
    rotation: 0
    state: enabled
- name: blocks_interleaved_short_to_complex_0
  id: blocks_interleaved_short_to_complex
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    scale_factor: '1.0'
    swap: 'False'
    vector_input: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [656, 424.0]
    rotation: 0
    state: enabled
- name: blocks_throttle2_1
  id: blocks_throttle2
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    ignoretag: 'True'
    limit: auto
    maximum: '0.1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: samp_rate
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [880, 144.0]
    rotation: 0
    state: enabled
- name: blocks_wavfile_sink_0
  id: blocks_wavfile_sink
  parameters:
    affinity: ''
    alias: ''
    append: 'False'
    bits_per_sample1: FORMAT_FLOAT
    bits_per_sample2: FORMAT_PCM_16
    bits_per_sample3: FORMAT_VORBIS
    bits_per_sample4: FORMAT_PCM_16
    comment: FORMAT_FLOAT, not the PCM_16 default -- quadrature_demod_cf's gain can
      push the output past +-1.0, and PCM_16 would silently clip that instead of erroring.
    file: '"Output/" + rec_stem + "_48k.wav"'
    format: FORMAT_WAV
    nchan: '1'
    samp_rate: '48000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2032, 516.0]
    rotation: 0
    state: enabled
- name: freq_xlating_fir_filter_xxx_0_0_0
  id: freq_xlating_fir_filter_xxx
  parameters:
    affinity: ''
    alias: ''
    center_freq: '0'
    comment: ''
    decim: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    taps: variable_low_pass_filter_taps_0_2
    type: ccf
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1008, 344.0]
    rotation: 0
    state: enabled
- name: plotcap_af
  id: plot_capture
  parameters:
    affinity: ''
    alias: ''
    comment: Tap after the Quadrature Demod -- demodulated audio.
    mode: time,psd
    nfft: '1024'
    nsamples: n_capture
    out_dir: Figure
    prefix: rec_stem
    samp_rate: samp_rate
    save_npy: 'False'
    skip: '0'
    sps: '0'
    title: ''
    type: float
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1664, 836.0]
    rotation: 0
    state: disabled
- name: plotcap_iq
  id: plot_capture
  parameters:
    affinity: ''
    alias: ''
    comment: Tap after the Throttle -- raw IQ before the filter/demod chain.
    mode: spec
    nfft: '1024'
    nsamples: n_capture
    out_dir: Figure
    prefix: rec_stem
    samp_rate: samp_rate
    save_npy: 'False'
    skip: '0'
    sps: '0'
    title: ''
    type: complex
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1176, 28.0]
    rotation: 0
    state: enabled
- name: qtgui_freq_sink_x_0
  id: qtgui_freq_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    average: '1.0'
    axislabels: 'True'
    bw: samp_rate
    color1: '"blue"'
    color10: '"dark blue"'
    color2: '"red"'
    color3: '"green"'
    color4: '"black"'
    color5: '"cyan"'
    color6: '"magenta"'
    color7: '"yellow"'
    color8: '"dark red"'
    color9: '"dark green"'
    comment: ''
    ctrlpanel: 'False'
