# --- Editor / IDE ---
.vscode/
.idea/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# --- OS junk ---
.DS_Store
Thumbs.db

# --- Office lock files ---
~$*.xlsx

# --- Claude Code working notes (not for publishing) ---
CLAUDE.md
doc/

# --- GRC build artifacts: grcc/GRC-GUI generate these from a .grc, don't track them ---
appendix_gnuradio/hdlc_bitorder_test.py
appendix_gnuradio/hdlc_bitorder_test_*.py
appendix_gnuradio/*_epy_block_*.py
appendix_gnuradio/hdlc_check.grc
appendix_gnuradio/hdlc_check.py
appendix_gnuradio/hdlc_check_*.py
appendix_gnuradio/hdlc check.py

# --- 04_Beacon/Output: only the cut_first3.ogg example workbooks are tracked;
#     outputs from other recordings (e.g. satnogs_*.ogg) stay local-only ---
04_Beacon/Output/*
!04_Beacon/Output/cut_first3_*

# NOTE: Figure/*.png, Data/*.ogg, and 04_Beacon/Output/cut_first3_*.xlsx are
# intentionally kept (tracked), they are the example outputs and the shared
# recording.

# --- Recordings: default to local-only, allow-list the shared ones.
#     Deliberately default-deny: new diagnostic .ogg files keep getting added
#     during investigation, and listing them one at a time meant new ones sat
#     un-ignored (and one `git add -A` away from being published by accident).
#     To share a new recording, add an explicit `!` exception below. ---
Data/*.ogg
!Data/cut_first3.ogg
!Data/satnogs_14459039_2026-07-07T09-57-46.ogg

# --- 01a/01b are diagnostic/exploratory tools -- their output figures are
#     working files, not canonical example outputs like 01_frame*.png ---
01_frame_detection/Figure/01a_overview_*
01_frame_detection/Figure/01b_candidate*
