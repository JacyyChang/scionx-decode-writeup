      "3":"Y-Wheel momentum stabilized – Initial Pitch Acquisition","4":"Y-Wheel momentum stabilized – Steady State",
      "5":"XYZ-Wheel control","6":"Rwheel sun tracking control","7":"Rwheel target tracking control",
      "8":"Very Fast-spin Detumbling control","9":"Fast-spin Detumbling control",
      "10":"User Specific Control Mode 1","11":"User Specific Control Mode 2","12":"Stop R-wheels",
      "13":"User Coded Control Mode","14":"Yaw-only or roll-only sun tracking mode","15":"Target-tracking yaw-only wheel control Mode"
      },
    "ADCS_Run_Mode":{
      "0":"Off","1":"Enabled","2":"Triggered","3":"Simulation"},
    "ADCS Sensors&Actuator":{"0":"OFF","1":"ON"},
    "ADCS Error Flag":{"0":" No error","1":" Error"},
    "ADCS_Commissioning_State":{
      "0":"Initial Angular Rate Estimation","1":"Detumbling","2":"Magnetometer Deployment",
      "3":"Magnetometer Calibration","4":"XYZ reaction wheel control",
      "5":"Sun/Nadir Sensor Commissioning","6":"CubeStar Commissioning","7":"Sun Tracking 3-Axis Control",
      "9":" None, all finished"},
    "ADCS_Mag_Cal_DataLog_Flag":{"0":" Complete","1":"Incomplete"},
    "ADCS_Finetune_Bias_XYZ":{"0":" Complete","1":"Incomplete"},
    "ADCS_Finetune_Bias_SunTrack":{"0":" Complete","1":"Incomplete"},
    "ADCS_Finetune_Bias_Y":{"0":" No fine-tuning","1":"Need fine-tuning"},
    "ADCS_Processed_Flag":{"0":" has NOT been processed ","1":" has been processed"},
    "ADCS_TC_Error_Status":{"0":"No Error","1":"Invaild telecommand ID","2":"Incorrect TC parameter length","3":"Incorrect TC parameter value","4":"CRC check failed"},
    
    "UHF_SWD_Function":{"0":"ON","1":"OFF"},
