{
  "enums": {
    "is_nominal":{"0":"containgency state(safe, phoneix)","1":"nominal state(charging, COMM, SCI)"},
    "uhf_tx_pwr":{"0":"Low power(0.3W)","1":"Full power(1.5W)"},
    "Spacecraft_mode": {
      "0":"Phoenix Mode","1":"Safe Mode","2":"Charging Mode","3":"Communication Xband Mode",
      "A":"Science HyperSCAN Mode","B":"Science CIP Mode","C":"Reentry Mode","FF":"Undefine Mode"},
    "EPS_onoff_state":{"0":"OFF","1":"ON"},
    "ADCS_onoff_state":{"0":"OFF","1":"ON"},
    "UHF_onoff_state":{"0":"OFF","1":"ON"},
    "Xband_onoff_state":{"0":"OFF","1":"ON"},
    "CIP_onoff_state":{"0":"OFF","1":"ON"},
    "HyperSCAN_onoff_state":{"0":"OFF","1":"ON"},
    "SEUV_onoff_state":{"0":"OFF","1":"ON"},
    "APRS_onoff_state":{"0":"OFF","1":"ON"},
    
    "ADCS_AE_Mode":{
      "0":"No attitude estimation","1":"MEMS rate sensing","2":"Magnetometer rate filter",
      "3":"Magnetometer rate filter with pitch estimation","4":"Magnetometer and Fine-sun TRIAD algorithm ",
